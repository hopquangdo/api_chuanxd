								                        </li>
								                        <li role="presentation">
								                            <a href="https://caselaw.vn/van-ban-phap-luat/462580-tieu-chuan-quoc-gia-tcvn-5687-2024-ve-thong-gio-dieu-hoa-khong-khi-yeu-cau-thiet-ke-nam-2024?banan=true" title="Bản án áp dụng">
								                                <i class="fa fa-list-alt"></i> Bản án áp dụng
								                            </a>
								                        </li>
								                    </ul>
                                            </div>
                                                                                                                                                                                    <p class="pt-10">
                                                    Vui lòng 
                                                    <a class="color-red" data-toggle="modal" data-target="#myModal">
                                                        Đăng ký
                                                    </a>
                                                    tài khoản hoặc 
                                                    <a class="color-red" data-toggle="modal" data-target="#myModal">
                                                        đăng nhập
                                                    </a>
                                                     để xem và tải văn bản gốc.
                                                </p>
                                                                                        
                                            
